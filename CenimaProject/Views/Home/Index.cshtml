@{
    Layout = "";
}

<style>
    /* إعداد الخلفية العامة */
    body, html {
        margin: 0;
        padding: 0;
        overflow: hidden;
        font-family: Arial, sans-serif;
    }

    /* تنسيق قسم الهيرو */
    .hero-section {
        position: relative;
        background: linear-gradient(45deg, #ff6600, #ff3300);
        color: white;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        overflow: hidden;
    }

    /* أيقونات متحركة */
    .hero-section::before {
        content: "🎟️ 🎥 🍿 🎬 📷 🎭 🎟️ 🎥 🍿 🎬 📷 🎭 🎟️ 🎥 🍿 🎬 📷 🎭 🎟️ 🎥 🍿 🎬 📷 🎭";
        position: absolute;
        font-size: 2rem;
        color: rgba(255, 255, 255, 0.2);
        white-space: nowrap;
        animation: moveIcons 20s linear infinite;
        top: 50%;
        left: 0;
        width: 200%;
        transform: translateY(-50%);
        z-index: 1;
    }

    /* حركة الأيقونات */
     moveIcons {
        from { transform: translateX(100%); }
        to { transform: translateX(-100%); }
    }

    /* تنسيق العناوين */
    .hero-section h1 {
        font-size: 3rem;
        font-weight: bold;
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.5);
    }

    .hero-section p {
        font-size: 1.5rem;
        margin-bottom: 30px;
        position: relative;
        z-index: 2;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.5);
    }

    /* تنسيق الأزرار */
    .hero-section .btn {
        background-color: white;
        color: #ff6600;
        padding: 12px 25px;
        font-size: 1.2rem;
        text-decoration: none;
        border-radius: 30px;
        transition: all 0.3s ease;
        position: relative;
        z-index: 2;
        font-weight: bold;
        margin: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.3);
        border: 2px solid transparent;
    }

    /* تأثير عند تمرير الماوس */
    .hero-section .btn:hover {
        background-color: #ffcc00;
        color: #fff;
        border-color: white;
        transform: scale(1.1);
    }

</style>

<div class="hero-section">
    <h1>مرحبًا بكم في موقعنا</h1>
    <p>استمتع بأفضل العروض والأفلام الحصرية</p>
    <a href="@Url.Action("Login", "Home")" class="btn">تسجيل الدخول</a>
    <a href="@Url.Action("Signup", "Home")" class="btn">إنشاء حساب</a>
    @*   <a href="@Url.Action("New", "Admin")" class="btn">Add New</a>
    <a href="@Url.Action("Rules", "Admin")" class="btn">Rules</a>
 *@
</div>