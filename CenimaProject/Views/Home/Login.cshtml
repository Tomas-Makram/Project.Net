@model Login
@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول</title>
    <style>
        /* إعداد الصفحة */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: Arial, sans-serif;
            background: linear-gradient(45deg, #ff6600, #ff3300);
            overflow: hidden;
        }

        /* أيقونات متحركة في الخلفية */
        .background-icons {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }

        .background-icons span {
            position: absolute;
            font-size: 2rem;
            color: rgba(255, 255, 255, 0.2);
            animation: moveIcons 10s linear infinite;
        }

        moveIcons {
            from { transform: translateX(100%); }
            to { transform: translateX(-100%); }
        }

        /* تصميم نموذج تسجيل الدخول */
        .login-container {
            position: relative;
            z-index: 2;
            background: rgba(255, 255, 255, 0.9);
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 400px;
            margin: 10% auto;
            text-align: center;
        }

        .login-container h2 {
            margin-bottom: 20px;
            font-size: 2rem;
            color: #333;
        }

        .login-container input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1rem;
        }

        .login-container .button {
            width: 100%;
            padding: 10px;
            background-color: #ff6600;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1.2rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .login-container button:hover {
            background-color: #ff3300;
        }

        .login-container p {
            margin-top: 20px;
            font-size: 0.9rem;
            color: #555;
        }

        .login-container a {
            color: #ff6600;
            text-decoration: none;
        }

        .login-container a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <!-- أيقونات متحركة في الخلفية -->
    <div class="background-icons">
        <span style="top: 10%; left: -10%; animation-delay: 0s;">🎟️</span>
        <span style="top: 20%; left: -20%; animation-delay: 2s;">🎥</span>
        <span style="top: 30%; left: -30%; animation-delay: 4s;">🍿</span>
        <span style="top: 40%; left: -40%; animation-delay: 6s;">🎬</span>
        <span style="top: 50%; left: -50%; animation-delay: 8s;">📷</span>
        <span style="top: 60%; left: -60%; animation-delay: 10s;">🎭</span>
    </div>

    <!-- نموذج تسجيل الدخول -->
    <div class="login-container">
        <h2>تسجيل الدخول</h2>
        
        <form method="post">
            <dev>
                <label asp-for="UName"> User Name</label>
                <input asp-for="UName" id="Name" type="text" placeholder="User Name" required>
                <span asp-validation-for="UName" class="text-danger"></span>
                <script>
                        document.getElementById("Name").focus();
                </script>
            </dev>
            <dev>
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" placeholder="Password" required>
                <span asp-validation-for="Password" class="text-danger"></span>
                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessageUser))
                {
                    <p style="color: red; font-weight: bold;">@ViewBag.ErrorMessageUser</p>
                }
            </dev>
           
            <input class="button" style="text-align: center;" type="submit" value="Login"/>
             <p>Don't have an account? <a asp-controller="Home" asp-action="Signup">Sign Up</a></p>
        </form>
    </div>
</body>
</html>